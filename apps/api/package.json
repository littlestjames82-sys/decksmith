{
  "name": "@decksmith/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "vercel:bundle": "esbuild src/vercel-entry.js --bundle --platform=node --format=cjs --target=node20 --outfile=../../api/_app.cjs --external:@prisma/client --external:@prisma/adapter-libsql --external:@libsql/*",
    "netlify:bundle": "esbuild src/netlify-entry.js --bundle --platform=node --format=cjs --target=node20 --outfile=../../netlify/functions/api-bundle.cjs --external:@prisma/client --external:@prisma/adapter-libsql --external:@libsql/*"
  },
  "dependencies": {
    "@decksmith/shared": "workspace:*",
    "@decksmith/ai": "workspace:*",
    "@decksmith/database": "workspace:*",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.25.0"
  }
}
